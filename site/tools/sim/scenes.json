{
  "offline-settings": {
    "title": "离线时按 OK 打开设置",
    "steps": [
      {"name": "开机进入设备连接", "expect": ["设备连接", "OK 设置"]},
      {"name": "按 OK 进入设置", "key": "ok", "expect": ["设置", "网络状态", "设备维护", "返回上级"]}
    ]
  },
  "offline-maintenance": {
    "title": "离线诊断、维护确认取消和长按回主页",
    "steps": [
      {"name": "开机进入设备连接", "expect": ["设备连接", "OK 设置"]},
      {"name": "打开设置", "key": "ok", "expect": ["设置", "网络状态", "设备维护"]},
      {"name": "选择网络状态", "key": "down", "expect": ["设置"]},
      {"name": "查看网络诊断", "key": "ok", "capture": true, "expect": ["网络状态", "OK 返回 · 长↑主页"], "contains": ["信号 未连接", "最大连续块"], "absent": ["信号 -127 dBm", "密码 "]},
      {"name": "从网络诊断返回设置并保留焦点", "waitMs": 350, "key": "ok", "expect": ["设置", "设备维护"]},
      {"name": "移动到休眠项", "key": "down", "expect": ["设置"]},
      {"name": "移动到设备维护", "key": "down", "expect": ["设置"]},
      {"name": "打开维护菜单", "key": "ok", "expect": ["设备维护", "重载配置", "恢复出厂", "返回上级"]},
      {"name": "离线重载给出明确提示", "waitMs": 350, "key": "ok", "expect": ["设备维护", "离线，联网后才能重载"]},
      {"name": "用上键循环到返回", "key": "up", "expect": ["设备维护"]},
      {"name": "移动到恢复出厂", "key": "up", "expect": ["设备维护"]},
      {"name": "查看恢复出厂确认", "key": "ok", "capture": true, "expect": ["恢复出厂？", "上下选择 · OK取消"]},
      {"name": "按 OK 采用默认取消", "waitMs": 350, "key": "ok", "expect": ["设备维护", "已取消"]},
      {"name": "长按上键返回主页", "key": "up", "ms": 850, "expect": ["设备连接", "OK 设置"]},
      {"name": "查询固件串口状态", "serial": "pp.status", "serialContains": ["\"app\":\"PA-Terminal\"", "\"connected\":false"], "expect": ["设备连接"]}
    ]
  }
}
