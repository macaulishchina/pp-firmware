      {"name": "移动到声音与屏幕", "key": "down", "expect": ["操作菜单", "任务消息", "声音与屏幕", "网络与配对", "电源与待机", "返回主页"]},
      {"name": "移动到网络与配对", "key": "down", "expect": ["操作菜单", "任务消息", "声音与屏幕", "网络与配对", "电源与待机", "返回主页"]},
      {"name": "进入网络与配对", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["网络与配对", "网络状态", "重试连接", "设置 Wi-Fi", "PA 与维护", "返回上级"]},
      {"name": "查看网络诊断", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["网络状态", "OK 返回 · 长↑主页"], "capture": true, "contains": ["信号 未连接", "最大连续块"], "absent": ["信号 -127 dBm", "密码 "]},
      {"name": "返回并保留网络状态焦点", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["网络与配对", "网络状态", "重试连接", "设置 Wi-Fi", "PA 与维护", "返回上级"]},
      {"name": "设置中长按下只移动一项", "key": "down", "expect": ["网络与配对", "用已存 Wi-Fi 连接 PA"], "ms": 850},
      {"name": "查看设置 Wi-Fi 的说明", "key": "down", "expect": ["网络与配对", "开启热点，手机填写网络"]},
      {"name": "选择 PA 与维护", "key": "down", "expect": ["网络与配对", "网络状态", "重试连接", "设置 Wi-Fi", "PA 与维护", "返回上级"]},
      {"name": "打开 PA 与维护", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["PA 与维护", "同步 PA 设置", "更换 PA 配对", "恢复出厂设置", "返回上级", "从 PA 获取设备设置"], "capture": true},
      {"name": "离线同步给出明确提示", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["PA 与维护", "请先连上 PA 再同步"]},
      {"name": "查看更换配对的说明", "key": "down", "expect": ["PA 与维护", "保留 Wi-Fi，绑定新会话"]},
      {"name": "选中关于设备", "key": "down", "expect": ["PA 与维护", "关于设备", "查看硬件和固件版本"]},
      {"name": "离线打开关于设备", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["关于设备", "OK 返回 · 长↑主页"], "contains": ["FoloToy AI Passport", "芯片 ESP32-C3", "闪存 8MB", "固件 0.", "协议 2"], "capture": true},
      {"name": "关于设备页保持同屏信息", "key": "down", "expect": ["关于设备", "OK 返回 · 长↑主页"], "contains": ["FoloToy AI Passport", "芯片 ESP32-C3", "闪存 8MB", "固件 0.", "协议 2"]},
      {"name": "按 OK 回到关于设备的原焦点", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["PA 与维护", "关于设备", "查看硬件和固件版本"]},
      {"name": "查看恢复出厂的说明", "key": "down", "expect": ["PA 与维护", "清除本机网络与配对"]},
      {"name": "进入恢复出厂确认", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["恢复出厂设置？", "上下选择 · OK取消"], "capture": true},
      {"name": "选择默认取消", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["PA 与维护", "同步 PA 设置", "更换 PA 配对", "恢复出厂设置", "返回上级", "已取消"]},
      {"name": "选择返回上级", "key": "down", "expect": ["PA 与维护", "同步 PA 设置", "更换 PA 配对", "恢复出厂设置", "返回上级"]},
      {"name": "回到网络与配对", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["网络与配对", "网络状态", "重试连接", "设置 Wi-Fi", "PA 与维护", "返回上级"]},
      {"name": "沿原焦点下移到返回上级", "key": "down", "expect": ["网络与配对", "网络状态", "重试连接", "设置 Wi-Fi", "PA 与维护", "返回上级"]},
      {"name": "返回双列菜单", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["操作菜单", "任务消息", "声音与屏幕", "网络与配对", "电源与待机", "返回主页"]},
      {"name": "从网络与配对下移到电源与待机", "key": "down", "expect": ["操作菜单", "任务消息", "声音与屏幕", "网络与配对", "电源与待机", "返回主页"]},
      {"name": "打开电源设置", "key": "ok", "ms": 100, "waitMs": 350, "expect": ["电源与待机", "自动休眠 · 开", "熄屏保持 Wi-Fi · 开", "立即休眠"]},
      {"name": "长按上回到热点页", "key": "up", "expect": ["设备连接", "OK 菜单"], "ms": 850},
      {"name": "检查设备依然等待配网", "expect": ["设备连接"], "serial": "pp.status", "serialContains": ["\"app\":\"PA-Terminal\"", "\"connected\":false"]}
    ]
